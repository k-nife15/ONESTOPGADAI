{
  "name": "OneStopGadai - Notifikasi WA Business",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gadai-notif-wa",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111101",
      "name": "Webhook Gadai Notif WA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 260],
      "webhookId": "gadai-notif-wa"
    },
    {
      "parameters": {
        "operation": "send",
        "recipientPhoneNumber": "={{ $json.body.nomorHp }}",
        "textBody": "={{ $json.body.pesan }}",
        "additionalFields": {}
      },
      "id": "11111111-1111-4111-8111-111111111102",
      "name": "WhatsApp Business Send",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [500, 260],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"sent\": true,\n  \"sbr\": \"{{ $('Webhook Gadai Notif WA').item.json.body.sbr }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "11111111-1111-4111-8111-111111111103",
      "name": "Respond Sukses",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"sent\": false,\n  \"reason\": \"{{ $json.error?.message || 'Nomor tidak terdaftar di WhatsApp atau gagal kirim' }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "11111111-1111-4111-8111-111111111104",
      "name": "Respond Gagal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 340]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "22222222-2222-4222-8222-222222222201",
      "name": "Cron 08:00 Harian",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 560]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3000/api/wa/due-reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "bprs-gadai-2026-rahasia"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222202",
      "name": "Ambil Jatuh Tempo H-3 & H-0",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 560]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222203",
      "name": "Split Daftar Nasabah",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 560]
    },
    {
      "parameters": {
        "operation": "send",
        "recipientPhoneNumber": "={{ $json.nomorHp }}",
        "textBody": "={{ $json.pesan }}",
        "additionalFields": {}
      },
      "id": "22222222-2222-4222-8222-222222222204",
      "name": "Kirim WA Pengingat Jatuh Tempo",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [960, 560],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "33333333-3333-4333-8333-333333333301",
      "name": "WhatsApp Status Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [240, 820]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-failed-status",
              "leftValue": "={{ $json.statuses?.[0]?.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333302",
      "name": "Cek Jika Status Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 820]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/wa/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "bprs-gadai-2026-rahasia"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"nomorHp\": \"{{ $json.statuses[0].recipient_id }}\",\n  \"status\": \"failed\",\n  \"errorCode\": \"{{ $json.statuses[0].errors?.[0]?.code || '' }}\",\n  \"reason\": \"{{ $json.statuses[0].errors?.[0]?.title || 'Nomor tidak terdaftar di WhatsApp' }}\"\n}",
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333303",
      "name": "Lapor Gagal ke Web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 820]
    }
  ],
