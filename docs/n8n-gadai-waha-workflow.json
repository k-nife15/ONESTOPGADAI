{
  "name": "OneStopGadai - Notifikasi WAHA (Localhost)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gadai-notif-wa",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111101",
      "name": "Webhook Gadai Notif WA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 260],
      "webhookId": "gadai-notif-wa"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3001/api/contacts/check-exists?session=default&phone={{ $json.body.nomorHp }}",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111102",
      "name": "Cek Nomor WA (WAHA)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 260],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-number-exists",
              "leftValue": "={{ $json.numberExists }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111103",
      "name": "Nomor Terdaftar di WA?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session\": \"default\",\n  \"chatId\": \"{{ $('Webhook Gadai Notif WA').item.json.body.nomorHp }}@c.us\",\n  \"text\": {{ JSON.stringify($('Webhook Gadai Notif WA').item.json.body.pesan) }}\n}",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111104",
      "name": "Kirim WA via WAHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 140],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"sent\": true,\n  \"sbr\": \"{{ $('Webhook Gadai Notif WA').item.json.body.sbr }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1111111-1111-4111-8111-111111111105",
      "name": "Respond Sukses",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"sent\": false,\n  \"reason\": \"Nomor tidak terdaftar di WhatsApp atau gagal kirim via WAHA\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1111111-1111-4111-8111-111111111106",
      "name": "Respond Gagal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 320]
    },
    {
      "parameters": {
        "rule": {
