      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\nconst rawNomor = String(body.nomor || body.phone || body.nomorHp || '').trim();\n\n// 1. Bersihkan karakter selain angka\nlet nomorBersih = rawNomor.replace(/[^0-9]/g, '');\n\n// 2. Ubah awalan '0' menjadi '62'\nif (nomorBersih.startsWith('0')) {\n  nomorBersih = '62' + nomorBersih.slice(1);\n}\n\n// 3. Tambahkan @c.us jika nomor tidak kosong\nconst chatId = nomorBersih ? `${nomorBersih}@c.us` : '';\nconst isValid = nomorBersih.length >= 10 && nomorBersih.length <= 15;\n\nreturn [\n  {\n    json: {\n      nomor: nomorBersih,\n      chatId: chatId,\n      isValid: isValid\n    }\n  }\n];"
      },
